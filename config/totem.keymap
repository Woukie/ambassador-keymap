#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE 0
#define NAV  1
#define SYM  2
#define ADJ  3
#define TVP1 4
#define TVP2 5

&mt {
    quick-tap-ms = <100>;
    global-quick-tap;
    flavor = "tap-preferred";
    tapping-term-ms = <170>;
};

/ {
    combos { compatible = "zmk,combos"; };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            label = "BASE";
            bindings = <
         &kp SQT        &kp COMMA  &kp DOT  &kp P  &kp Y        &kp F      &kp G  &kp C  &kp R  &kp L
         &kp A          &kp O      &kp E    &kp U  &kp I        &kp D      &kp H  &kp T  &kp N  &kp S
&kp DEL  &kp SEMICOLON  &kp Q      &kp J    &kp K  &kp X        &kp B      &kp M  &kp W  &kp V  &kp Z  &kp BACKSPACE
                                   &mo 3    &mo 1  &kp SPACE    &kp ENTER  &mo 2  &mo 4
            >;
        };

        left_modifiers {
            bindings = <
       &mo 5           &none       &none      &none         &none    &trans  &trans  &trans  &trans  &trans
       &kp LEFT_SHIFT  &kp ESCAPE  &kp LCTRL  &kp LCMD      &none    &trans  &trans  &trans  &trans  &trans
&mo 8  &mo 6           &kp TAB     &kp CAPS   &kp LEFT_ALT  &none    &trans  &trans  &trans  &trans  &trans  &trans
                                   &none      &none         &none    &trans  &trans  &trans
            >;
        };

        right_modifiers {
            bindings = <
        &trans  &trans  &trans  &trans  &trans    &none  &none         &none      &none    &none
        &trans  &trans  &trans  &trans  &trans    &none  &kp LEFT_GUI  &kp LCTRL  &kp ESC  &kp LSHFT
&trans  &trans  &trans  &trans  &trans  &trans    &none  &kp LEFT_ALT  &kp CAPS   &kp TAB  &mo 7      &mo 9
                        &trans  &trans  &trans    &none  &none         &none
            >;
        };

        left_numerical {
            bindings = <
       &none  &kp N7  &kp N8  &kp N9  &none     &trans  &trans  &trans  &trans  &trans
       &none  &kp N4  &kp N5  &kp N6  &kp N0    &trans  &trans  &trans  &trans  &trans
&none  &none  &kp N1  &kp N2  &kp N3  &none     &trans  &trans  &trans  &trans  &trans  &trans
                      &none   &none   &none     &trans  &trans  &trans
            >;
        };

        right_extras {
            bindings = <
        &trans  &trans  &trans  &trans  &trans    &none  &none     &none     &none      &none
        &trans  &trans  &trans  &trans  &trans    &none  &kp LBKT  &kp RBKT  &kp EQUAL  &kp MINUS
&trans  &trans  &trans  &trans  &trans  &trans    &none  &kp FSLH  &kp BSLH  &kp GRAVE  &none      &none
                        &trans  &trans  &trans    &none  &none     &none
            >;
        };

        left_system {
            bindings = <
       &none  &out OUT_USB  &bt BT_CLR      &out OUT_BLE  &none    &trans  &trans  &trans  &trans  &trans
       &none  &bt BT_PRV    &bt BT_CLR_ALL  &bt BT_NXT    &none    &trans  &trans  &trans  &trans  &trans
&none  &none  &none         &studio_unlock  &none         &none    &trans  &trans  &trans  &trans  &trans  &trans
                            &none           &none         &none    &trans  &trans  &trans
            >;
        };

        left_navigation {
            bindings = <
       &none  &kp HOME   &kp UP    &kp END    &none    &trans  &trans  &trans  &trans  &trans
       &none  &kp LEFT   &kp DOWN  &kp RIGHT  &none    &trans  &trans  &trans  &trans  &trans
&none  &none  &kp PG_UP  &none     &kp PG_DN  &none    &trans  &trans  &trans  &trans  &trans  &trans
                         &none     &none      &none    &trans  &trans  &trans
            >;
        };

        right_mouse {
            bindings = <
        &trans  &trans  &trans  &trans  &trans    &none  &mkp LCLK       &mmv MOVE_UP    &mkp RCLK        &none
        &trans  &trans  &trans  &trans  &trans    &none  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &none
&trans  &trans  &trans  &trans  &trans  &trans    &none  &msc SCRL_DOWN  &none           &msc SCRL_UP     &none  &none
                        &trans  &trans  &trans    &none  &none           &none
            >;
        };

        left_media {
            bindings = <
       &none  &none       &kp C_VOLUME_UP  &none       &none    &trans  &trans  &trans  &trans  &trans
       &none  &kp C_PREV  &kp C_VOL_DN     &kp C_NEXT  &none    &trans  &trans  &trans  &trans  &trans
&none  &none  &none       &kp C_PP         &none       &none    &trans  &trans  &trans  &trans  &trans  &trans
                          &none            &none       &none    &trans  &trans  &trans
            >;
        };

        right_function {
            bindings = <
        &trans  &trans  &trans  &trans  &trans    &kp F12  &kp F7  &kp F8  &kp F9  &none
        &trans  &trans  &trans  &trans  &trans    &kp F11  &kp F4  &kp F5  &kp F6  &none
&trans  &trans  &trans  &trans  &trans  &trans    &kp F10  &kp F1  &kp F2  &kp F3  &none  &none
                        &trans  &trans  &trans    &none    &none   &none
            >;
        };

        // ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄
        // ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄
        // ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄
        // ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄
        // ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄
    };
};
